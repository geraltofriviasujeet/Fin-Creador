{
  "name": "fin-creador",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @fin-creador/web",
    "dev:mobile": "npm run start -w @fin-creador/mobile",
    "dev:mobile:google": "npm run start:hostname -w @fin-creador/mobile --",
    "build": "npm run build -w @fin-creador/web",
    "bundle:mobile": "npm run bundle -w @fin-creador/mobile",
    "lint": "eslint . && npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "tokens": "npm run generate -w @fin-creador/design-tokens",
    "test:watch": "vitest",
    "db:types": "supabase gen types typescript --linked --schema public > packages/api/src/database.types.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "^9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
