# Copy to .env.local and fill in values from Supabase Dashboard > Project Settings > API.
# EXPO_PUBLIC_ variables are embedded in the app bundle. Never put a service-role or secret key here;
# the app refuses to start with one.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Web app base URL. Email confirmation and password-reset links open here.
# On a phone, "localhost" is the phone itself: use your Mac's LAN address
# (e.g. http://192.168.1.20:3000) if you want to open those links on the phone.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Google sign-in in Expo Go: start with `npm run dev:mobile:google` (Supabase rejects
# redirects to IP addresses). Redirect URLs in Supabase need exp://** and fincreador://**.
