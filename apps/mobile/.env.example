# Copy to .env.local and fill in values from Supabase Dashboard > Project Settings > API.
# EXPO_PUBLIC_ variables are embedded in the app bundle. Never put a service-role or secret key here.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Web base URL used to open the password-recovery flow from the app.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
