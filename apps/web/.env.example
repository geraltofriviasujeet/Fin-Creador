# Copy to .env.local and fill in values from Supabase Dashboard > Project Settings > API.
# Only public (publishable/anon) values belong here. Never add a service-role or secret key
# to any NEXT_PUBLIC_ variable — those are bundled into the browser.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public base URL of this app, used to build auth redirect links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
